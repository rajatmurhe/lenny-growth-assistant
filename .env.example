# ============================================================
# Lenny Growth Assistant - Environment Variables
# Copy this file to .env and fill in required values.
# REQUIRED values must be set. OPTIONAL values have working defaults.
# Never commit .env - it is in .gitignore.
# ============================================================

# ──────────────────────────────────────────────────────────
# DATABASE (REQUIRED)
# ──────────────────────────────────────────────────────────

# PostgreSQL credentials. Change for production.
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_secret          # CHANGE IN PRODUCTION
POSTGRES_DB=lenny_db

# ──────────────────────────────────────────────────────────
# OLLAMA (REQUIRED for local mode)
# ──────────────────────────────────────────────────────────

# Ollama server URL. When running via Docker Compose, use host.docker.internal.
# When running backend locally outside Docker, use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Chat model. Must be pulled in Ollama before running.
# Default: llama3.2:3b (runs on ~4GB RAM, adequate instruction following)
# Alternative: qwen2.5:7b-instruct (better quality, needs ~8GB RAM)
#   To swap: ollama pull qwen2.5:7b-instruct, then set below.
OLLAMA_CHAT_MODEL=llama3.2:3b

# Embedding model. Must be pulled in Ollama before running.
# Default: nomic-embed-text (768-dim, warm P50 ~80ms)
OLLAMA_EMBED_MODEL=nomic-embed-text

# ──────────────────────────────────────────────────────────
# ANTHROPIC (OPTIONAL - enables cloud provider)
# ──────────────────────────────────────────────────────────

# If set, the Anthropic provider will be available in the UI toggle.
# If not set, Anthropic is disabled with a visible reason in the UI.
# ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model to use (only matters if ANTHROPIC_API_KEY is set)
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-20241022

# ──────────────────────────────────────────────────────────
# PROVIDER SELECTION (OPTIONAL)
# ──────────────────────────────────────────────────────────

# Active LLM provider at startup. Overridable per-session via UI or API.
# Values: "ollama" | "anthropic"
ACTIVE_PROVIDER=ollama

# ──────────────────────────────────────────────────────────
# RETRIEVAL (OPTIONAL - safe defaults)
# ──────────────────────────────────────────────────────────

# Number of chunks to retrieve per query (before threshold filtering)
RETRIEVAL_TOP_K=10

# Minimum RRF score threshold. Queries below this return "insufficient evidence".
# Range: 0.0 - 1.0. Lower = more permissive (risk of hallucination). Higher = stricter.
RETRIEVAL_THRESHOLD=0.35

# ──────────────────────────────────────────────────────────
# TRANSCRIPTS (OPTIONAL)
# ──────────────────────────────────────────────────────────

# URL to clone transcripts from. Default: public starter pack (50 episodes).
# Paid subscribers: set to your private lennysdata.com repo URL.
TRANSCRIPT_REPO_URL=https://github.com/LennysNewsletter/lennys-newsletterpodcastdata.git

# ──────────────────────────────────────────────────────────
# FRONTEND (OPTIONAL)
# ──────────────────────────────────────────────────────────

# Backend API URL as seen from the browser. Default works for local Docker Compose.
VITE_API_URL=http://localhost:8000

# ──────────────────────────────────────────────────────────
# APPLICATION (OPTIONAL)
# ──────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# LLM generation timeout in seconds. Increase if using larger models.
REQUEST_TIMEOUT_S=60

# Max tokens to generate per response
MAX_TOKENS_GENERATE=2000
